# Default configuration (fallback)
[user]
    email = peterrc@outlook.dk
    name = Peter
	signingkey = /home/peter/.ssh/id_ed5519_work.pub

# Conditional includes based on directory
[includeIf "gitdir:~/repos/private/"]
    path = ~/dotfiles/git/.gitconfig-private

[includeIf "gitdir:~/repos/work/"]
    path = ~/dotfiles/git/.gitconfig-work

[includeIf "gitdir:~/repos/migration-dotnet10/"]
    path = ~/dotfiles/git/.gitconfig-work

# Default SSH URL rewriting (private account)
[url "git@github.com:"]
    insteadOf = https://github.com/

# GitHub CLI credential helpers (default)
[credential "https://github.com"]
    helper = 
    helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper = 
    helper = !/usr/bin/gh auth git-credential
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
